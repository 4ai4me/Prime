rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 120 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Sole Admin Teacher (Google email liha1634@gmail.com + runtime owner fallback)
    // 익명 로그인 학생에게는 email 항목이 없으므로 .get(이름, 기본값)으로 읽음
    // (직접 읽으면 규칙 '오류'로 집계되어, 정상적인 거부와 진짜 오류를 구분하기 어려워짐)
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.get('email_verified', false) == true &&
        (
          request.auth.token.get('email', '') == 'liha1634@gmail.com' ||
          request.auth.token.get('email', '') == 'planitia4ai@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // 이 가입 문서의 주인(학생 익명 계정)인지
    function isRegistrationOwner(data) {
      return isSignedIn() && data.get('uid', '') == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // 학생 가입 (2026-11-28~ 가상 정보 방식, schema 2)
    //   student_registrations/v2_{이름}
    //   학교 '하연 학교' 고정 · 년도(가입일, 한국 시간) · 랜덤 한글 이름(2~4자) · 학년(중1~고3)
    //   · 교사가 만든 그 년도 반 목록 안의 반 · 비밀번호 해시(필수)
    //   이름이 곧 문서 키이므로 같은 이름으로는 하나만 만들어짐(중복 가입 불가)
    // 예전 방식(실명·학번·생년월일) 문서로는 학생이 읽기·쓰기·재연결 모두 할 수 없음 (교사만)
    // ------------------------------------------------------------------
    function isPasswordHash(v) {
      return v is string && v.matches('^[0-9a-f]{64}$');
    }

    function isV2Key(id) {
      return id is string && id.matches('^v2_[가-힣]{2,4}$');
    }

    // 가입 문서 키: 새 방식(v2_이름) 또는 영문·숫자 키(예전 문서·이전기록 legacy_001)
    function isRegKey(id) {
      return isValidId(id) || isV2Key(id);
    }

    function isV2Doc(data) {
      return data.get('schema', 0) == 2;
    }

    // 한국 시간(UTC+9) 기준 년도
    function koreanYear() {
      return string((request.time + duration.value(9, 'h')).year());
    }

    // 교사가 만든 그 년도·학년의 반 목록에 있는 반인지
    function isRosterClass(year, grade, className) {
      let path = /databases/$(database)/documents/app_settings/$('class_roster_' + year);
      return exists(path) && className in get(path).data.classes.get(grade, []);
    }

    function isValidV2Registration(data) {
      return data.keys().hasAll([
          'studentKey', 'schema', 'school', 'year', 'grade', 'className', 'name', 'status',
          'uid', 'passwordHash', 'deviceHash', 'ipAddress', 'userAgent', 'worksheetJson',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentKey', 'schema', 'school', 'year', 'grade', 'className', 'name', 'status',
          'uid', 'passwordHash', 'deviceHash', 'ipAddress', 'userAgent', 'worksheetJson',
          'createdAt', 'updatedAt',
          'claimPasswordHash', 'resetCodeHash', 'resetCodeExpiresAt', 'resetProof'
        ]) &&
        data.schema == 2 &&
        data.name is string && data.name.matches('^[가-힣]{2,4}$') &&
        data.studentKey == 'v2_' + data.name &&
        data.school == '하연 학교' &&
        data.year is string && data.year.matches('^20[0-9]{2}$') &&
        data.grade in ['중1', '중2', '중3', '고1', '고2', '고3'] &&
        data.className is string && data.className.matches('^[가-힣]{1,8}반$') &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.uid is string && data.uid.size() <= 128 &&
        isPasswordHash(data.passwordHash) &&
        data.get('claimPasswordHash', '') is string &&
        (data.get('claimPasswordHash', '') == '' || data.get('claimPasswordHash', '').matches('^[0-9a-f]{64}:[A-Za-z0-9]{8,64}$')) &&
        (data.get('resetCodeHash', '') == '' || isPasswordHash(data.get('resetCodeHash', ''))) &&
        (!('resetCodeExpiresAt' in data) || data.resetCodeExpiresAt is timestamp) &&
        (data.get('resetProof', '') == '' || isPasswordHash(data.get('resetProof', ''))) &&
        data.deviceHash is string && data.deviceHash.size() >= 6 && data.deviceHash.size() <= 80 && data.deviceHash.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ipAddress is string && data.ipAddress.size() >= 3 && data.ipAddress.size() <= 64 &&
        data.userAgent is string && data.userAgent.size() >= 1 && data.userAgent.size() <= 250 &&
        data.worksheetJson is string && data.worksheetJson.size() >= 2 && data.worksheetJson.size() <= 150000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 예전 방식 문서 형식 (교사 화면에서 다루던 형식 — 학생은 더 이상 쓸 수 없음)
    function isValidStudentRegistration(data) {
      return data.keys().hasAll([
          'studentKey', 'school', 'grade', 'classNum', 'studentNum',
          'birthDate', 'name', 'deviceHash', 'ipAddress', 'userAgent',
          'status', 'worksheetJson', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentKey', 'school', 'grade', 'classNum', 'studentNum',
          'birthDate', 'name', 'deviceHash', 'ipAddress', 'userAgent',
          'status', 'worksheetJson', 'createdAt', 'updatedAt',
          'uid', 'claimName', 'claimBirthDate', 'passwordHash', 'claimPasswordHash'
        ]) &&
        data.studentKey is string && data.studentKey.size() >= 3 && data.studentKey.size() <= 120 &&
        data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
        data.worksheetJson is string && data.worksheetJson.size() >= 2 && data.worksheetJson.size() <= 150000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 이전기록 (2026-11-28 개인정보 정리 후 남긴 가명 기록, 교사만 읽기, 2027-03-31까지 화면에 표시)
    function isValidLegacyArchive(data, studentKey) {
      return data.keys().hasAll(['studentKey', 'schema', 'legacySerial', 'grade', 'status', 'worksheetJson', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['studentKey', 'schema', 'legacySerial', 'grade', 'status', 'worksheetJson', 'createdAt', 'updatedAt']) &&
        studentKey.matches('^legacy_[0-9]{3,5}$') &&
        data.studentKey == studentKey &&
        data.schema == 'legacy' &&
        data.legacySerial is string && data.legacySerial.size() <= 20 &&
        data.grade is string && data.grade.size() <= 5 &&
        data.status == 'archived' &&
        data.worksheetJson is string && data.worksheetJson.size() >= 2 && data.worksheetJson.size() <= 150000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidDeviceLock(data) {
      return data.keys().hasAll(['deviceHash', 'studentKey', 'ipAddress', 'createdAt']) &&
        data.keys().hasOnly(['deviceHash', 'studentKey', 'ipAddress', 'createdAt']) &&
        data.deviceHash is string && data.deviceHash.size() >= 6 && data.deviceHash.size() <= 80 && data.deviceHash.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.studentKey is string && data.studentKey.size() >= 3 && data.studentKey.size() <= 120 && data.studentKey.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ipAddress is string && data.ipAddress.size() >= 3 && data.ipAddress.size() <= 64 &&
        data.createdAt is timestamp;
    }

    // Connection test path
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }

    // Admin lookup collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // Student Registrations Collection
    match /student_registrations/{studentKey} {
      // 읽기: 교사, 또는 새 방식 문서의 주인(학생 본인).
      // 없는 문서 확인(이름 중복 확인)은 로그인한 사용자 누구나 — 남의 문서는 '거부'로 돌아옴
      allow get: if isRegKey(studentKey) &&
        (isAdmin() || (isSignedIn() && (resource == null || (isV2Doc(resource.data) && isRegistrationOwner(resource.data)))));
      // 목록 조회: 교사만
      allow list: if isAdmin();

      // 학생 가입 신청 (새 방식만): 'pending'으로 시작, 본인 익명 계정 uid를 주인으로,
      // 년도는 오늘(한국 시간), 반은 교사가 만든 목록 안에서, 비밀번호 해시 필수, 코드 관련 칸은 비움
      allow create: if isV2Key(studentKey) &&
        isSignedIn() &&
        isValidV2Registration(incoming()) &&
        incoming().studentKey == studentKey &&
        incoming().status == 'pending' &&
        incoming().uid == request.auth.uid &&
        incoming().get('claimPasswordHash', '') == '' &&
        incoming().get('resetCodeHash', '') == '' &&
        !('resetCodeExpiresAt' in incoming()) &&
        incoming().get('resetProof', '') == '' &&
        incoming().year == koreanYear() &&
        isRosterClass(incoming().year, incoming().grade, incoming().className) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // 교사: 이전기록 문서 만들기 (예전 개인정보 정리)
      allow create: if isValidId(studentKey) &&
        isAdmin() &&
        isValidLegacyArchive(incoming(), studentKey);

      allow update: if isRegKey(studentKey) &&
        incoming().studentKey == existing().studentKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // 1) 교사: 승인·반려·평가·일회용 코드 발급
          (isAdmin() && (isValidV2Registration(incoming()) || isValidStudentRegistration(incoming()))) ||
          (
            isV2Doc(existing()) && isValidV2Registration(incoming()) &&
            (
              // 2) 승인된 학생 본인: 접속 정보만 갱신
              (
                isRegistrationOwner(existing()) &&
                existing().status == 'approved' &&
                incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'deviceHash', 'ipAddress', 'userAgent'])
              ) ||
              // 3) 다른 기기·브라우저에서 로그인: 비밀번호가 맞으면 이 익명 계정으로 연결
              //    이번 요청에 새로 담긴 "해시:임의값" 증명의 해시가 저장된 해시와 같아야 함
              //    (임의값이 매번 바뀌므로 문서에 남아 있는 예전 증명으로는 통과할 수 없음)
              (
                isSignedIn() &&
                incoming().uid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'claimPasswordHash', 'updatedAt']) &&
                incoming().diff(existing()).affectedKeys().hasAny(['claimPasswordHash']) &&
                incoming().claimPasswordHash.split(':')[0] == existing().passwordHash
              ) ||
              // 4) 비밀번호 분실: 교사가 발급한 일회용 코드(30분, 1번)로 새 비밀번호 설정
              //    코드 해시를 맞혀야 하고, 쓰는 순간 코드가 지워져 다시 쓸 수 없음
              (
                isSignedIn() &&
                incoming().uid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'passwordHash', 'resetCodeHash', 'resetProof', 'updatedAt']) &&
                isPasswordHash(existing().get('resetCodeHash', '')) &&
                existing().get('resetCodeExpiresAt', null) is timestamp &&
                request.time < existing().resetCodeExpiresAt &&
                incoming().get('resetProof', '') == existing().resetCodeHash &&
                incoming().get('resetCodeHash', '') == ''
              )
            )
          )
        );

      allow delete: if isRegKey(studentKey) && isAdmin();
    }

    // ------------------------------------------------------------------
    // 차시별 분리 저장 문서
    //   student_registrations/{studentKey}/func_lessons/l1..l7, teacher
    //   student_registrations/{studentKey}/props_lessons/l1..l7, teacher
    //   student_registrations/{studentKey}/prime_lessons/l1..l6, teacher  (중1 소인수분해 Prime, 2026-11-11~)
    //   student_registrations/{studentKey}/rational_lessons/l1..l14, teacher  (중1 정수와 유리수 Rational, 2026-11-25~)
    // l1..l7: 승인된 학생 본인(또는 교사)만 쓰기 / teacher: 교사만 쓰기
    // 읽기: 교사 또는 학생 본인
    // ------------------------------------------------------------------
    function registrationData(studentKey) {
      return get(/databases/$(database)/documents/student_registrations/$(studentKey)).data;
    }

    // 가입 문서가 없으면(삭제된 학생 등) 오류 대신 '본인 아님'으로 판단
    // 새 방식(schema 2) 문서의 주인만 — 예전 방식 문서의 주인이던 브라우저로는 열 수 없음
    function isStudentOwnerOf(studentKey) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/student_registrations/$(studentKey)) &&
        isV2Doc(registrationData(studentKey)) &&
        registrationData(studentKey).get('uid', '') == request.auth.uid;
    }

    function isLessonCollection(course) {
      return course == 'func_lessons' || course == 'props_lessons' || course == 'prime_lessons';
    }

    // 정수와 유리수(Rational)는 14차시라 l1..l14를 쓰므로 위 l1..l7 규칙과 따로 둠
    function isAnyLessonCollection(course) {
      return isLessonCollection(course) || course == 'rational_lessons';
    }

    function isValidLessonDoc(data, studentKey, docId) {
      return data.keys().hasAll(['studentKey', 'lesson', 'schemaVersion', 'data', 'clientUpdatedAt', 'updatedAt']) &&
        data.keys().hasOnly(['studentKey', 'lesson', 'schemaVersion', 'data', 'clientUpdatedAt', 'updatedAt']) &&
        data.studentKey == studentKey &&
        data.lesson is int && ('l' + string(data.lesson)) == docId &&
        data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100 &&
        data.data is string && data.data.size() >= 2 && data.data.size() <= 200000 &&
        data.clientUpdatedAt is string && data.clientUpdatedAt.size() <= 40 &&
        data.updatedAt == request.time;
    }

    function isValidTeacherDoc(data, studentKey) {
      return data.keys().hasAll(['studentKey', 'schemaVersion', 'data', 'updatedAt']) &&
        data.keys().hasOnly(['studentKey', 'schemaVersion', 'data', 'updatedAt']) &&
        data.studentKey == studentKey &&
        data.schemaVersion is int && data.schemaVersion >= 1 && data.schemaVersion <= 100 &&
        data.data is string && data.data.size() >= 2 && data.data.size() <= 100000 &&
        data.updatedAt == request.time;
    }

    match /student_registrations/{studentKey}/{course}/{docId} {
      allow get, list: if isRegKey(studentKey) && isAnyLessonCollection(course) &&
        (isAdmin() || isStudentOwnerOf(studentKey));

      // 차시 내용: 승인된 학생 본인 또는 교사
      allow create, update: if isRegKey(studentKey) && isLessonCollection(course) &&
        docId.matches('^l[1-7]$') &&
        isValidLessonDoc(incoming(), studentKey, docId) &&
        (
          isAdmin() ||
          (isStudentOwnerOf(studentKey) && registrationData(studentKey).get('status', '') == 'approved')
        );

      // 차시 내용 (정수와 유리수 l1..l14): 승인된 학생 본인 또는 교사
      allow create, update: if isRegKey(studentKey) && course == 'rational_lessons' &&
        docId.matches('^l([1-9]|1[0-4])$') &&
        isValidLessonDoc(incoming(), studentKey, docId) &&
        (
          isAdmin() ||
          (isStudentOwnerOf(studentKey) && registrationData(studentKey).get('status', '') == 'approved')
        );

      // 교사 평가·메모: 교사만
      allow create, update: if isRegKey(studentKey) && isAnyLessonCollection(course) &&
        docId == 'teacher' &&
        isValidTeacherDoc(incoming(), studentKey) &&
        isAdmin();

      allow delete: if isAnyLessonCollection(course) && isAdmin();
    }

    // 교사 화면: 모든 학생의 차시 문서를 한 번에 조회 (collection group)
    match /{path=**}/func_lessons/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/props_lessons/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/prime_lessons/{docId} {
      allow read: if isAdmin();
    }
    match /{path=**}/rational_lessons/{docId} {
      allow read: if isAdmin();
    }

    // Device / MAC Lock Collection (Permits shared computer lab/cart tablets while logging device identity)
    match /device_locks/{deviceHash} {
      allow get: if isValidId(deviceHash) && isSignedIn();
      allow list: if isAdmin();

      allow create: if isValidId(deviceHash) &&
        isSignedIn() &&
        isValidDeviceLock(incoming()) &&
        incoming().deviceHash == deviceHash &&
        incoming().createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/student_registrations/$(incoming().studentKey));

      allow update: if isValidId(deviceHash) &&
        isSignedIn() &&
        isValidDeviceLock(incoming()) &&
        (
          isAdmin() ||
          incoming().deviceHash == existing().deviceHash
        );

      allow delete: if isValidId(deviceHash) && isAdmin();
    }

    function isValidAccessLog(data) {
      return data.keys().hasAll([
          'logId', 'studentKey', 'school', 'grade', 'classNum', 'studentNum',
          'name', 'eventType', 'status', 'deviceHash', 'ipAddress', 'userAgent', 'createdAt'
        ]) &&
        data.logId is string && data.logId.size() >= 3 && data.logId.size() <= 120 &&
        data.studentKey is string && data.studentKey.size() >= 3 && data.studentKey.size() <= 120 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
        data.eventType is string && data.eventType in ['login', 'register', 'resume', 'save'] &&
        data.status is string && data.status in ['pending', 'approved', 'rejected', 'teacher'] &&
        data.createdAt is timestamp;
    }

    // Student Real-time Access Logs Collection (for audit trail and morning/afternoon monitoring)
    match /student_access_logs/{logId} {
      // 접속 기록은 교사만 열람
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) &&
        isSignedIn() &&
        isValidAccessLog(incoming()) &&
        incoming().logId == logId &&
        incoming().createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    function isValidLessonAccessSetting(data) {
      return data.keys().hasAll(['l1', 'l2', 'l3', 'l4', 'l5', 'l6', 'l7', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['l1', 'l2', 'l3', 'l4', 'l5', 'l6', 'l7', 'updatedBy', 'updatedAt']) &&
        data.l1 is bool &&
        data.l2 is bool &&
        data.l3 is bool &&
        data.l4 is bool &&
        data.l5 is bool &&
        data.l6 is bool &&
        data.l7 is bool &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    // Func 전용 차시 잠금 (2026-11-05~, 1~8차시). Props와 함께 쓰던 lesson_access(7칸)는 그대로 둠
    // 2026-11-13 9차시(무리함수를 두 차시로 나눔) 칸 l9 추가 — 선택 항목이라 예전 화면이 쓰는 8칸 문서도 그대로 허용
    function isValidFuncLessonAccessSetting(data) {
      return data.keys().hasAll(['l1', 'l2', 'l3', 'l4', 'l5', 'l6', 'l7', 'l8', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['l1', 'l2', 'l3', 'l4', 'l5', 'l6', 'l7', 'l8', 'l9', 'updatedBy', 'updatedAt']) &&
        (!('l9' in data) || data.l9 is bool) &&
        data.l1 is bool &&
        data.l2 is bool &&
        data.l3 is bool &&
        data.l4 is bool &&
        data.l5 is bool &&
        data.l6 is bool &&
        data.l7 is bool &&
        data.l8 is bool &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    // Func 반별 차시 잠금 (2026-11-09~). classes = { '년도|학년|반이름': { l1..l9 } } (2026-11-28~ 새 반, 예전 키는 '학교|학년|반')
    // 교사만 쓰므로 반마다의 칸은 앱이 읽을 때 검사(칸이 틀린 반은 무시하고 전체 설정을 따름)
    function isValidFuncClassLessonAccessSetting(data) {
      return data.keys().hasAll(['classes', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['classes', 'updatedBy', 'updatedAt']) &&
        data.classes is map &&
        data.classes.size() <= 60 &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    // Prime(중1 소인수분해) 전용 차시 잠금 (2026-11-11~, 1~6차시)
    function isValidPrimeLessonAccessSetting(data) {
      return data.keys().hasAll(['l1', 'l2', 'l3', 'l4', 'l5', 'l6', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['l1', 'l2', 'l3', 'l4', 'l5', 'l6', 'updatedBy', 'updatedAt']) &&
        data.l1 is bool &&
        data.l2 is bool &&
        data.l3 is bool &&
        data.l4 is bool &&
        data.l5 is bool &&
        data.l6 is bool &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    // Rational(중1 정수와 유리수) 전용 차시 잠금 (2026-11-25~, 1~14차시)
    function isValidRationalLessonAccessSetting(data) {
      return data.keys().hasAll(['l1', 'l2', 'l3', 'l4', 'l5', 'l6', 'l7', 'l8', 'l9', 'l10', 'l11', 'l12', 'l13', 'l14', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['l1', 'l2', 'l3', 'l4', 'l5', 'l6', 'l7', 'l8', 'l9', 'l10', 'l11', 'l12', 'l13', 'l14', 'updatedBy', 'updatedAt']) &&
        data.l1 is bool &&
        data.l2 is bool &&
        data.l3 is bool &&
        data.l4 is bool &&
        data.l5 is bool &&
        data.l6 is bool &&
        data.l7 is bool &&
        data.l8 is bool &&
        data.l9 is bool &&
        data.l10 is bool &&
        data.l11 is bool &&
        data.l12 is bool &&
        data.l13 is bool &&
        data.l14 is bool &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    // 새 이름 반 목록 (2026-11-28~). app_settings/class_roster_{년도}
    //   classes = { '중1': ['참새반', ...], ... } — 교사만 쓰기, 가입 화면을 위해 누구나 읽기
    function isValidClassRoster(data, settingId) {
      return data.keys().hasAll(['year', 'classes', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['year', 'classes', 'updatedBy', 'updatedAt']) &&
        data.year is string && data.year.matches('^20[0-9]{2}$') &&
        settingId == 'class_roster_' + data.year &&
        data.classes is map &&
        data.classes.keys().hasOnly(['중1', '중2', '중3', '고1', '고2', '고3']) &&
        data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    // Classroom-wide Lesson Access ON/OFF Settings (Readable by students, writable by Admin Teacher)
    match /app_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;
      allow create, update: if settingId == 'lesson_access' &&
        isValidLessonAccessSetting(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if settingId == 'lesson_access' && isAdmin();

      // Func 전용 차시 잠금 (교사만 변경, 읽기는 위 allow get으로 누구나)
      allow create, update: if settingId == 'func_lesson_access' &&
        isValidFuncLessonAccessSetting(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if settingId == 'func_lesson_access' && isAdmin();

      // Func 반별 차시 잠금 (교사만 변경, 읽기는 위 allow get으로 누구나 — 반 이름과 열림 여부만 있음)
      allow create, update: if settingId == 'func_lesson_access_classes' &&
        isValidFuncClassLessonAccessSetting(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if settingId == 'func_lesson_access_classes' && isAdmin();

      // Prime(중1 소인수분해) 전용 차시 잠금 1~6차시 (2026-11-11~, 교사만 변경, 읽기는 위 allow get으로 누구나)
      allow create, update: if settingId == 'prime_lesson_access' &&
        isValidPrimeLessonAccessSetting(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if settingId == 'prime_lesson_access' && isAdmin();

      // Prime 반별 차시 잠금 (형식은 Func 반별 잠금과 같음 — 반마다의 칸은 앱이 읽을 때 검사)
      allow create, update: if settingId == 'prime_lesson_access_classes' &&
        isValidFuncClassLessonAccessSetting(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if settingId == 'prime_lesson_access_classes' && isAdmin();

      // Rational(중1 정수와 유리수) 전용 차시 잠금 1~14차시 (2026-11-25~, 교사만 변경, 읽기는 위 allow get으로 누구나)
      allow create, update: if settingId == 'rational_lesson_access' &&
        isValidRationalLessonAccessSetting(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if settingId == 'rational_lesson_access' && isAdmin();

      // Rational 반별 차시 잠금 (형식은 Func 반별 잠금과 같음 — 반마다의 칸은 앱이 읽을 때 검사)
      allow create, update: if settingId == 'rational_lesson_access_classes' &&
        isValidFuncClassLessonAccessSetting(incoming()) &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow delete: if settingId == 'rational_lesson_access_classes' && isAdmin();

      // 새 이름 반 목록 (교사만 변경). 예전 '학생 비밀번호 사용 설정'(student_auth)은 2026-11-28에 없앰 — 비밀번호는 항상 필수
      allow create, update: if settingId.matches('^class_roster_20[0-9]{2}$') &&
        isValidClassRoster(incoming(), settingId) &&
        incoming().updatedAt == request.time &&
        isAdmin();
    }
  }
}

